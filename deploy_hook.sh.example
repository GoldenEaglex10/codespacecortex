#!/usr/bin/env bash
# Rename to deploy_hook.sh and chmod +x to activate.
# Runs on the server, cwd = /var/www/codespacecortex, after each deploy.
set -euo pipefail

# Example for a Python/FastAPI app:
# python3 -m venv venv --upgrade-deps
# ./venv/bin/pip install -r requirements.txt
# pm2 restart codespacecortex-api || pm2 start "venv/bin/uvicorn main:app --host 127.0.0.1 --port 8020" --name codespacecortex-api

# Example for a Node app:
# npm ci
# npm run build
# pm2 restart codespacecortex-web || pm2 start npm --name codespacecortex-web -- start
