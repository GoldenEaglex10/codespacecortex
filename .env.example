# Copy this file to .env and fill in your real key.
# Never commit the real .env file to GitHub.

# Which LLM provider to use: "mock", "ollama", or "anthropic"
# - mock: no model at all, canned fake responses, zero setup
# - ollama: uses your local Ollama model, free, no API key needed
# - anthropic: uses the real Claude API (needs a working key + credits)
LLM_PROVIDER=ollama

# Only needed if LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# SQLite database file (created automatically on first run)
DATABASE_PATH=./cortex.db
